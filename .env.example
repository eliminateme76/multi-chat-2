# WSL Ubuntu에서 PostgreSQL을 로컬로 설치한 경우의 기본 연결 값입니다.
DATABASE_URL=postgresql://sceneweaver:sceneweaver_dev_password@localhost:5432/sceneweaver
PORT=3000
HOST=0.0.0.0
CODEX_MODEL=gpt-5.6-sol
CODEX_TURN_TIMEOUT_MS=120000
# 반드시 미리 생성하고 별도로 codex login을 완료한 절대 경로를 사용하세요.
SCENEWEAVER_CODEX_HOME=/home/user/.codex-sceneweaver
# 스토리 Agent가 저장소의 개발용 AGENTS.md를 읽지 않도록 별도 빈 작업 경로를 사용합니다.
SCENEWEAVER_AGENT_CWD=/home/user/.codex-sceneweaver/workspace
CHARACTER_THREAD_TURN_LIMIT=12
CHARACTER_THREAD_TOKEN_LIMIT=50000
DIRECTOR_THREAD_TURN_LIMIT=8
DIRECTOR_THREAD_TOKEN_LIMIT=80000
